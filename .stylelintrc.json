{
    "plugins": ["stylelint-order"],
    "rules": {
        "order/properties-order": [
            [
                "content",
                "z-index",
                "float",
                "clear",
                "flex",
                "flex-grow",
                "flex-shrink",
                "flex-basis",
                "box-sizing",
                "position",
                "appearance",
                "display",
                "vertical-align",
                "grid",
                "grid-template-columns",
                "grid-template-rows",
                "flex-wrap",
                "flex-direction",
                "align-items",
                "align-content",
                "justify-content",
                "align-self",
                "order",
                "gap",
                "top",
                "right",
                "bottom",
                "left",
                "transform",
                "min-width",
                "width",
                "max-width",
                "min-height",
                "height",
                "max-height",
                "margin",
                "margin-top",
                "margin-right",
                "margin-bottom",
                "margin-left",
                "padding",
                "padding-top",
                "padding-right",
                "padding-bottom",
                "padding-left",
                "background",
                "background-color",
                "color",
                "caret-color",
                "font-size",
                "font-style",
                "font-family",
                "font-weight",
                "line-height",
                "text-align",
                "text-decoration",
                "text-decoration-color",
                "text-decoration-line",
                "text-decoration-style",
                "text-indent",
                "text-underline-offset",
                "text-transform",
                "text-shadow",
                "text-overflow",
                "letter-spacing",
                "white-space",
                "word-break",
                "word-wrap",
                "list-style",
                "border",
                "border-top",
                "border-top-color",
                "border-top-width",
                "border-top-style",
                "border-right",
                "border-right-color",
                "border-right-width",
                "border-right-style",
                "border-bottom",
                "border-bottom-color",
                "border-bottom-width",
                "border-bottom-style",
                "border-left",
                "border-left-color",
                "border-left-width",
                "border-left-style",
                "border-color",
                "border-radius",
                "border-width",
                "border-style",
                "outline",
                "outline-offset",
                "outline-color",
                "outline-width",
                "outline-style",
                "box-shadow",
                "cursor",
                "opacity",
                "visibility",
                "pointer-events",
                "user-select",
                "field-sizing",
                "resize",
                "filter",
                "overflow",
                "overflow-wrap",
                "overflow-x",
                "overflow-y",
                "transition",
                "animation",
                "will-change"
            ],
            {
                "unspecified": "bottom"
            }
        ]
    }
}
